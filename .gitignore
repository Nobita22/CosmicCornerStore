# CosmicCorner — files that stay LOCAL (not uploaded to the hosted repo)
# The admin tool needs a real computer (writes files + pushes to git),
# so it must never be part of the repo that gets hosted.

server.py
admin.html
admin.css
admin.js

# Private order details (customer name/phone/email/address).
# NEVER commit this — the public orders.json only holds order_id + status.
orders-details.json

# Python cache
__pycache__/
*.pyc

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Temp / backup files
*.tmp
*.bak
# Local order database (customer PII)
orders.db

# Admin password hash (local only)
admin_auth.json
